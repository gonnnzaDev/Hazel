# ──────────────────────────────────────────────────────────────────────────────
# Recop — configuración de ejemplo
# Copiá este archivo a `.env` y ajustá los valores. NUNCA commitees `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Aplicación ───────────────────────────────────────────────────────────────
# Entorno: local | test | prod
RECOP_ENV=local
RECOP_DEBUG=true
# Secreto para firmar sesiones/tokens. Generá uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOP_SECRET_KEY=cambiame-por-algo-aleatorio-en-produccion

# ─── Solo para docker compose ─────────────────────────────────────────────────
# El nodo corre dentro de un container, así que estas variables no se usan en la
# configuración de la app: solo las lee el compose.
#
# Si no ponés RECOP_SECRET_KEY, `docker compose up` falla a propósito con un
# mensaje claro. Mejor que arrancar con un secreto de ejemplo en producción.

# Interfaz donde se publica el puerto del nodo. 0.0.0.0 para que se pueda
# entrar desde la red local; poné 127.0.0.1 si solo querés probarlo vos.
RECOP_PUBLISH_HOST=0.0.0.0
RECOP_PUBLISH_PORT=7272

POSTGRES_USER=recop
POSTGRES_PASSWORD=recop
POSTGRES_DB=recop
POSTGRES_PORT=5432

# Puerto del broker Kafka desde la máquina.
KAFKA_EXTERNAL_PORT=9092

# Si ponés varias réplicas del mismo nodo, poné esto en false en todas menos una.
# Con varias réplicas corriendo migraciones al arrancar se pisan entre ellas.
RECOP_AUTO_MIGRATE=true

# ─── Servidor HTTP ─────────────────────────────────────────────────────────────
# Puerto en el que este nodo escucha. Cuando el dueño despliega su servidor,
# este es el puerto que se abre en su PC.
RECOP_HOST=0.0.0.0
RECOP_PORT=7272
RECOP_ROOT_PATH=
# Orígenes permitidos por CORS. Separados por coma. `*` solo en local.
RECOP_CORS_ORIGINS=*

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Formato asyncpg: postgresql+asyncpg://usuario:password@host:puerto/db
RECOP_DATABASE_URL=postgresql+asyncpg://recop:recop@localhost:5432/recop
# Connection pool
RECOP_DB_POOL_SIZE=10
RECOP_DB_MAX_OVERFLOW=20
RECOP_DB_ECHO=false

# ─── Kafka (bus de eventos del chat) ───────────────────────────────────────────
# Desde la máquina, contra el compose de desarrollo. Dentro de la red de
# Docker el mismo broker responde en kafka:19092.
RECOP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Namespace de topics. Permite que varios nodos convivan en el mismo cluster.
RECOP_KAFKA_TOPIC_PREFIX=recop
RECOP_KAFKA_CLIENT_ID=
# Cuántos mensajes puede acumular un consumidor antes de hacer commit
RECOP_KAFKA_MAX_POLL_RECORDS=500

# ─── Límites de la aplicación ──────────────────────────────────────────────────
# Límite de mensajes por minuto y por nickname. Protección básica anti-abuso.
RECOP_RATE_LIMIT_MESSAGES_PER_MINUTE=20
# Tamaño máximo (bytes) de un mensaje de chat
RECOP_MAX_MESSAGE_BYTES=4000