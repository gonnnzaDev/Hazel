# ──────────────────────────────────────────────────────────────────────────────
# Recop — configuración de ejemplo
# Copiá este archivo a `.env` y ajustá los valores. NUNCA commitees `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Aplicación ────────────────────────────────────────────────────────────────
# Entorno: local | test | prod
RECOP_ENV=local
RECOP_DEBUG=true
# Secreto para firmar sesiones/tokens. Generá uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOP_SECRET_KEY=cambiame-por-algo-aleatorio-en-produccion

# ─── Servidor HTTP ─────────────────────────────────────────────────────────────
# Puerto en el que este nodo escucha. Cuando el dueño despliega su servidor,
# este es el puerto que se abre en su PC.
RECOP_HOST=0.0.0.0
RECOP_PORT=7272
RECOP_ROOT_PATH=
# Orígenes permitidos por CORS. Separados por coma. `*` solo en local.
RECOP_CORS_ORIGINS=*

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Formato asyncpg: postgresql+asyncpg://usuario:password@host:puerto/db
RECOP_DATABASE_URL=postgresql+asyncpg://recop:recop@localhost:5432/recop
# Connection pool
RECOP_DB_POOL_SIZE=10
RECOP_DB_MAX_OVERFLOW=20
RECOP_DB_ECHO=false

# ─── Kafka (bus de eventos del chat) ───────────────────────────────────────────
# 29092 es el listener externo del broker de desarrollo (docker-compose.yml).
# Dentro de la red de Docker el mismo broker responde en kafka:9092.
RECOP_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Namespace de topics. Permite que varios nodos convivan en el mismo cluster.
RECOP_KAFKA_TOPIC_PREFIX=recop
RECOP_KAFKA_CLIENT_ID=
# Cuántos mensajes puede acumular un consumidor antes de hacer commit
RECOP_KAFKA_MAX_POLL_RECORDS=500

# ─── Límites de la aplicación ──────────────────────────────────────────────────
# Límite de mensajes por minuto y por nickname. Protección básica anti-abuso.
RECOP_RATE_LIMIT_MESSAGES_PER_MINUTE=20
# Tamaño máximo (bytes) de un mensaje de chat
RECOP_MAX_MESSAGE_BYTES=4000